NODE_ENV=production
HOST=127.0.0.1
PORT=3080
PUBLIC_ORIGIN=https://crm.example.com
SECURE_COOKIES=true
DATA_DIR=/var/lib/marketloop
ADMIN_EMAIL=replace@example.com
ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_PASSWORD_AT_LEAST_12_CHARACTERS
TOKEN_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
CHROME_EXECUTABLE_PATH=/usr/bin/google-chrome-stable
CAMPAIGN_WORKER_ENABLED=false
FULFILMENT_WORKER_ENABLED=true
PAYMENTS_ENABLED=false
RAZORPAY_MERCHANTS_FILE=/etc/marketloop/payment-merchants.json
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
META_GRAPH_VERSION=
META_WEBHOOK_VERIFY_TOKEN=
# Required for non-ASCII product text on Linux:
CATALOGUE_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf

# Google OAuth web application credentials (optional product sync)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SHEETS_WORKER_ENABLED=true
