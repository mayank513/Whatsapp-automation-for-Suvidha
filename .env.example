# Copy to .env. Never put credentials in client-side files.
PORT=3080
HOST=127.0.0.1
PUBLIC_ORIGIN=http://127.0.0.1:3080
# For a hosted service use HTTPS, a persistent server and SECURE_COOKIES=true.
SECURE_COOKIES=false
# Set both before starting to create the creator/admin account; no default password.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=
# Your reviewed Meta business app and Embedded Signup configuration.
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
META_GRAPH_VERSION=
META_WEBHOOK_VERIFY_TOKEN=
# Optional existing Chrome executable for the linked-device service.
CHROME_EXECUTABLE_PATH=
# Enable only when ready for scheduled messages to subscribed customers.
CAMPAIGN_WORKER_ENABLED=false
# Optional Unicode TTF font. Windows Nirmala/Segoe UI is detected automatically.
CATALOGUE_FONT_PATH=
# Global worker switch; each store's notification settings remain OFF by default.
FULFILMENT_WORKER_ENABLED=true

# Step 7: server-side merchant credentials, per store. See STEP7.md.
PAYMENTS_ENABLED=false
# RAZORPAY_MERCHANTS_FILE=C:\private\payment-merchants.json

# Google Sheets product sync. See GOOGLE-SHEETS.md for OAuth setup.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SHEETS_WORKER_ENABLED=true
